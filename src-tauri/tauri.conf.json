{
  "productName": "CC Remote Seamless",
  "version": "0.1.0",
  "identifier": "com.cc-remote.seamless",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
    "resources": ["resources/sounds/*", "resources/icons/*"],
    "externalBin": ["../sidecar/feishu-gateway/feishu-gateway"]
  },
  "app": {
    "windows": [
      {
        "label": "float",
        "title": "CC Remote",
        "width": 220,
        "height": 150,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
